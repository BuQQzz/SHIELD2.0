{
  "name": "shield2.0",
  "version": "0.1.0",
  "description": "Privacy-first local AI chatbot for Windows with tool integration",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "download-model": "tsx scripts/download-model.ts",
    "test:inference": "tsx scripts/test-inference.ts",
    "test:service": "tsx scripts/test-service.ts"
  },
  "keywords": [
    "ai",
    "chatbot",
    "privacy",
    "local",
    "llama.cpp",
    "windows",
    "automation"
  ],
  "author": "BuQQzz",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "node-llama-cpp": "^3.14.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@huggingface/hub": "^2.6.12",
    "@tailwindcss/upgrade": "^4.1.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.8.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.0.6"
  }
}
