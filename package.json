{
  "name": "shield2.0",
  "version": "0.1.5",
  "description": "Privacy-first local AI chatbot for Windows with tool integration",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "tsc && vite build",
    "build:electron": "tsc && vite build && electron-builder",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:win:installer": "npm run build && electron-builder --win nsis --config electron-builder.yml",
    "build:win:portable": "npm run build && electron-builder --win portable --config electron-builder.yml",
    "build:dir": "npm run build && electron-builder --dir --config electron-builder.yml",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "download-model": "tsx scripts/download-model.ts",
    "test:inference": "tsx scripts/test-inference.ts",
    "test:service": "tsx scripts/test-service.ts",
    "bench:agent": "tsx scripts/bench/run.ts",
    "check-downloads": "node scripts/check-downloads.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "ai",
    "chatbot",
    "privacy",
    "local",
    "llama.cpp",
    "windows",
    "automation"
  ],
  "author": {
    "name": "BuQQzz",
    "url": "https://github.com/BuQQzz"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BuQQzz/SHIELD2.0"
  },
  "homepage": "https://github.com/BuQQzz/SHIELD2.0#readme",
  "bugs": {
    "url": "https://github.com/BuQQzz/SHIELD2.0/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.43.0",
    "jsdom": "^27.4.0",
    "lucide-react": "^0.451.0",
    "node-llama-cpp": "^3.21.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.0",
    "@huggingface/hub": "^2.6.12",
    "@tailwindcss/upgrade": "^4.1.0",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.8.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sqlite3": "^3.1.11",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.0.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.6"
  }
}
